{
  "name": "idle-buds",
  "private": true,
  "version": "0.0.0",
  "description": "Idle Buds web development foundation. Gameplay is not implemented.",
  "type": "module",
  "engines": {
    "node": ">=24.22.3 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings src vite.config.ts playwright.config.ts tests/e2e",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "npm run build && node tests/e2e/playwright.mjs test",
    "smoke": "npm test",
    "setup:browser": "node tests/e2e/playwright.mjs install chromium",
    "validate": "npm run lint && npm test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.4",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "oxlint": "1.95.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
