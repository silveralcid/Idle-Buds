# Optional: omit DATABASE_URL to use project-local real PostgreSQL via npm run play.
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/idle_buds_dev
HOST=127.0.0.1
PORT=3000
ALLOWED_ORIGIN=http://127.0.0.1:3000
# Set to the browser origin http://127.0.0.1:5173 when using the Vite dev client.
# IDLE_BUDS_INVITE=choose-a-private-test-invite-before-serving-remotely
# HTTPS ALLOWED_ORIGIN enables secure cookies; remote serving also requires an invite.
# Never put credentials in VITE_* variables. Public deployment is not configured.
