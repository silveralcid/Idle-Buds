{
  "schema_version": 2,
  "project_name": "Idle Buds",
  "project_kind": "web-game",
  "integration_branch": "main",
  "release_branch": null,
  "commands": {
    "setup": {
      "argv": [
        "npm",
        "ci"
      ],
      "cwd": ".",
      "timeout_seconds": 300,
      "mutates_external": false
    },
    "lint": {
      "argv": [
        "npm",
        "run",
        "lint"
      ],
      "cwd": ".",
      "timeout_seconds": 120,
      "mutates_external": false
    },
    "typecheck": {
      "argv": [
        "npm",
        "run",
        "typecheck"
      ],
      "cwd": ".",
      "timeout_seconds": 120,
      "mutates_external": false
    },
    "test": {
      "argv": [
        "npm",
        "test"
      ],
      "cwd": ".",
      "timeout_seconds": 600,
      "mutates_external": false
    },
    "build": {
      "argv": [
        "npm",
        "run",
        "build"
      ],
      "cwd": ".",
      "timeout_seconds": 180,
      "mutates_external": false
    },
    "security": {
      "argv": [
        "npm",
        "audit",
        "--audit-level=high"
      ],
      "cwd": ".",
      "timeout_seconds": 120,
      "mutates_external": false
    },
    "migration": {
      "argv": [
        "{python}",
        "tools/validate_migration.py"
      ],
      "cwd": ".",
      "timeout_seconds": 120,
      "mutates_external": false
    },
    "lab": {
      "argv": [
        "npm",
        "run",
        "lab:smoke"
      ],
      "cwd": ".",
      "timeout_seconds": 180,
      "mutates_external": false
    },
    "content": {
      "argv": [
        "npm",
        "run",
        "lab:content"
      ],
      "cwd": ".",
      "timeout_seconds": 60,
      "mutates_external": false
    }
  },
  "notes": "MVP implementation. npm test starts isolated real PostgreSQL (or requires an explicit loopback idle_buds_test DATABASE_URL), migrates, runs deterministic rules/database tests, builds and exercises the real server in Chromium. Browser install is a local prerequisite. No deployment or production database mutation. GitHub Actions is disabled by owner direction; verify locally or on the authorized rig. Historical hosted CI results are reported separately. Local Lab API/CLI and stdio MCP reuse authoritative rules and normal player routes. Lab checks use synthetic fixtures and ignored per-run artifacts; no model calls or extra service."
}
